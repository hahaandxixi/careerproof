+def shared_history_attribution_impossible(source_texts: list[str]) -> bool:
+    """True only when a source line explicitly states shared-account history
+    makes author attribution impossible. Historical, conditional, negative
+    and since-resolved statements never trigger."""
+    for text in source_texts:
+        for line in text.splitlines():
+            if re.search(r"如果|假设|是否|若已|若未", line):
+                continue
+            if re.search(r"旧记录|旧版|历史记录|此前|曾经|已改用|已换用|不再|现已", line):
+                continue
+            if re.search(
