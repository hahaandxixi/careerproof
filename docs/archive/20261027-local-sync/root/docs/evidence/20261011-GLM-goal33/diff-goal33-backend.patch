+                r"|(?:可以|能够|可).{0,4}(?:区分|归属|定位)",
+                line,
+            ):
+                continue
+            if _SHARED_ACCOUNT.search(line) and _ATTRIBUTION_IMPOSSIBLE.search(line):
+                return True
+    return False
