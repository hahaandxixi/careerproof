+        # Guard: normalizing the CIM comparison must not weaken the strict
+        # .NET-to-.NET check between sampling and the stop itself.
+        $script:realGetProcess40 = ${function:Get-Process}
+        $script:f40Calls = 0
+        function Get-Process { param($Id, $ErrorAction)
+            $script:f40Calls++
+            $start = [datetime]::new(639273191745370012, [DateTimeKind]::Utc)
+            if ($script:f40Calls -ge 3) { $start = [datetime]::new(639273191745370013, [DateTimeKind]::Utc) }
+            return @{ StartTime = $start }
+        }
+        try {
+            $script:goal37ProcTimes = @{ 903 = $null }
+            $script:goal37CimRows = @(@{ ProcessId = 903; ParentProcessId = 90; CreationDate = [datetime]::new(639273191745370010, [DateTimeKind]::Utc); CommandLine = 'owned-python uvicorn owned' })
+            $script:goal37StopCalls = @()
+            $manifest = @{ schemaVersion = 2; processes = @(@{ Id = 903; Started = ([datetime]::new(639273191745370012, [DateTimeKind]::Utc)).ToString('o'); Needle = 'owned-python'; Invocation = 'uvicorn owned' }) }
+            $rejected = $false
