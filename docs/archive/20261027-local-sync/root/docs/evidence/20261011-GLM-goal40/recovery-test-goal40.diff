+        $rejected = $false
+        try { Stop-ValidatedLocalProcesses $manifest (Join-Path $scratch 'unused.json') | Out-Null } catch { $rejected = $true }
+        if (!$rejected) { throw 'a CIM time above the .NET start was accepted' }
+        if ($script:goal37StopCalls.Count -ne 0) { throw 'the mismatched root was stopped' }
