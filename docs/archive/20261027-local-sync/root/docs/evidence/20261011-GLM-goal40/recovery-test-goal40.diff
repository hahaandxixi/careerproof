+    # ---------- F. goal40: CIM microsecond grid and temp cleanup ownership ----------
+    # Real measurement (Codex process 102808 and this repo's own PS 5.1 runs):
+    # CIM CreationDate floors the kernel 100ns creation time onto its
+    # microsecond grid while Get-Process keeps the full 100ns ticks, so the
+    # same process legitimately differs across the two APIs by up to 9 ticks
+    # (observed UTC ticks 639273191745370010 vs 639273191745370012). Cross-API
+    # identity checks must compare both sides on the CIM grid with integer
+    # arithmetic only; a full microsecond (10 ticks) or any .NET-to-.NET
+    # difference still means PID reuse.
+    Assert-Goal 'F1 the real cross-API tick gap is a legal identity that gets stopped' {
+        # Codex measured CIM ...5370010 vs .NET StartTime ...5370012 (2 ticks).
+        $cimUtc = [datetime]::new(639273191745370010, [DateTimeKind]::Utc)
+        $netUtc = [datetime]::new(639273191745370012, [DateTimeKind]::Utc)
+        $script:goal37ProcTimes = @{ 900 = $netUtc }
+        $script:goal37CimRows = @(@{ ProcessId = 900; ParentProcessId = 90; CreationDate = $cimUtc; CommandLine = 'owned-python uvicorn owned' })
+        $script:goal37StopCalls = @()
+        $manifest = @{ schemaVersion = 2; processes = @(@{ Id = 900; Started = $netUtc.ToString('o'); Needle = 'owned-python'; Invocation = 'uvicorn owned' }) }
+        $live = @(Stop-ValidatedLocalProcesses $manifest (Join-Path $scratch 'unused.json'))
+        if ($live.Count -ne 1 -or [int]$live[0].Id -ne 900) { throw 'the legal 2-tick-gap process was rejected' }
+        if ($script:goal37StopCalls -notcontains 900) { throw 'the accepted legal process was not stopped' }
+    }
+    Assert-Goal 'F2 a full microsecond of cross-API drift is still a reused PID' {
+        $cimUtc = [datetime]::new(639273191745370010, [DateTimeKind]::Utc)
+        $netUtc = [datetime]::new(639273191745370020, [DateTimeKind]::Utc)
+        $script:goal37ProcTimes = @{ 901 = $netUtc }
+        $script:goal37CimRows = @(@{ ProcessId = 901; ParentProcessId = 90; CreationDate = $cimUtc; CommandLine = 'owned-python uvicorn owned' })
+        $script:goal37StopCalls = @()
+        $manifest = @{ schemaVersion = 2; processes = @(@{ Id = 901; Started = $netUtc.ToString('o'); Needle = 'owned-python'; Invocation = 'uvicorn owned' }) }
+        $rejected = $false
+        try { Stop-ValidatedLocalProcesses $manifest (Join-Path $scratch 'unused.json') | Out-Null } catch { $rejected = $true }
