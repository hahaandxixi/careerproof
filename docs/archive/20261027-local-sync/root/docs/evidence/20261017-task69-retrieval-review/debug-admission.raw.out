--- compiled SQL of the project_file stage ---
SELECT project_files.id 
FROM project_files 
WHERE project_files.project_version_id IN (SELECT project_versions.id 
FROM project_versions JOIN projects ON projects.id = project_versions.project_id JOIN (SELECT project_versions.project_id AS project_id, project_versions.material_role AS material_role, max(project_versions.version_number) AS version_number 
FROM project_versions GROUP BY project_versions.project_id, project_versions.material_role) AS anon_1 ON anon_1.project_id = project_versions.project_id AND anon_1.material_role = project_versions.material_role AND anon_1.version_number = project_versions.version_number 
WHERE projects.student_id = ? AND projects.is_archived IS 0)
