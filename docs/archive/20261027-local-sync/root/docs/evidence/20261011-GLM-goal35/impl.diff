+function Assert-LocalStatePath([string]$Path) {
+    foreach ($candidate in @($Path, (Split-Path -Parent $Path))) {
+        if (!$candidate) { continue }
+        $item = Get-Item -LiteralPath $candidate -ErrorAction SilentlyContinue
