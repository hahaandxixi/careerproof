APP_NAME=CareerProof API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://careerproof:careerproof@127.0.0.1:5432/careerproof
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
STORAGE_BASE_DIR=./storage
MAX_ARCHIVE_BYTES=31457280
MAX_EXTRACTED_BYTES=104857600
MAX_FILE_BYTES=1048576
MAX_ARCHIVE_FILES=2000
TASK_CONCURRENCY=2
TASK_TIMEOUT_SECONDS=90
TASK_LEASE_SECONDS=120
TASK_PENDING_TIMEOUT_SECONDS=600
TASK_DISPATCH_INTERVAL_SECONDS=2
MAX_DOCUMENT_CHARACTERS=500000

# External AI stays disabled until the provider smoke test succeeds.
AI_PROVIDER=mock
AI_EXTERNAL_ENABLED=false
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_TIMEOUT_SECONDS=30
BAILIAN_MAX_ATTEMPTS=2
# Zhipu standard API; only the free Flash model is allowed by this adapter.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_TIMEOUT_SECONDS=90
ZHIPU_MAX_ATTEMPTS=2
AI_MODEL_CONCURRENCY=1
AI_WORKFLOW_TIMEOUT_SECONDS=180
AI_MAX_REQUIREMENTS=20
AI_LOCAL_FALLBACK_ENABLED=true
