APP_NAME=CareerProof API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://careerproof:careerproof@127.0.0.1:5432/careerproof
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
STORAGE_BASE_DIR=./storage
MAX_ARCHIVE_BYTES=31457280
MAX_EXTRACTED_BYTES=104857600
MAX_FILE_BYTES=1048576
MAX_ARCHIVE_FILES=2000
TASK_CONCURRENCY=2
TASK_TIMEOUT_SECONDS=90
TASK_LEASE_SECONDS=120
TASK_PENDING_TIMEOUT_SECONDS=600
TASK_DISPATCH_INTERVAL_SECONDS=2
MAX_DOCUMENT_CHARACTERS=500000
OCR_ENABLED=true
OCR_MAX_PAGES=10
OCR_MIN_CONFIDENCE=0.5
OCR_MAX_IMAGE_PIXELS=20000000

# DeepSeek is the required product provider. Fill the local key before using
# the launch scripts. Rules remain an automatic runtime fallback.
AI_PROVIDER=deepseek
AI_EXTERNAL_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_ATTEMPTS=2
# Text and screenshot understanding share this DeepSeek key/model.
# Per-image consent is required; images are billed and never sent by local OCR.
AI_MODEL_CONCURRENCY=1
AI_WORKFLOW_TIMEOUT_SECONDS=180
AI_MAX_REQUIREMENTS=8
AI_MAX_RETRIEVAL_CALLS=2
# Hard usage guards. Input is checked with a conservative local estimate before
# each request; daily counters use provider-reported tokens persisted in PostgreSQL.
AI_PER_REPORT_INPUT_TOKEN_LIMIT=12000
AI_PER_REPORT_OUTPUT_TOKEN_LIMIT=4000
AI_DAILY_REPORT_LIMIT=20
AI_DAILY_INPUT_TOKEN_LIMIT=200000
AI_DAILY_OUTPUT_TOKEN_LIMIT=40000
AI_SKIP_WHEN_NO_EVIDENCE=true
AI_LOCAL_FALLBACK_ENABLED=true

# Optional local multilingual ONNX model for source-exact project-document recall.
# Download once with: python -m app.scripts.download_semantic_model
# If absent, lexical retrieval remains active; no model file is downloaded at runtime.
SEMANTIC_RETRIEVAL_ENABLED=true
SEMANTIC_MODEL_CACHE_DIR=./.tmp/models
