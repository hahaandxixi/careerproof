# Preserve raw tool evidence exactly, including progress-line trailing spaces.
# These files are evidence, not source formatting; do not normalize their bytes.
docs/evidence/**/*.raw.out -text -whitespace
docs/evidence/**/*.raw.err -text -whitespace

# Double-click launchers and Windows PowerShell scripts keep Windows line endings.
*.cmd text eol=crlf
*.ps1 text eol=crlf
